DROPBOX_APP_KEY=
GDRIVE_CLIENT_ID=
GDRIVE_ANDROID_SERVER_CLIENT_ID=
GDRIVE_IOS_CLIENT_ID=
# GDRIVE_CLIENT_ID: Desktop OAuth client (Windows/Linux).
# GDRIVE_ANDROID_SERVER_CLIENT_ID: Web OAuth client used by Android's native
# Google Sign-In SDK (also register each Android package + signing SHA-1).
# GDRIVE_IOS_CLIENT_ID: iOS OAuth client matching the Runner bundle ID.
# Dropbox desktop: register http://localhost:43178; mobile SDK-style callback:
# db-<DROPBOX_APP_KEY>://2/token. iOS: run ios/Runner/generate_env_xcconfig.sh
# before building. No client secrets are needed for public native clients.
